		<Item class="LocalScript" referent="RBX5">
			<Properties>
				<ProtectedString name="Source"><![CDATA[-- Tool LocalScript — Eat animation + tick heal (+25 capped at 100)
-- Place inside the Tool as a LocalScript. Expects:
--   Tool.Event   (RemoteEvent)
--   Tool.Eat     (Animation)
-- Server fires Event:FireServer("EatAnim") to the client to trigger the eat.

local script_Parent = script.Parent
local VREnabled     = game:GetService("VRService").VREnabled
local LocalPlayer   = game.Players.LocalPlayer
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Event = script_Parent:WaitForChild("Event")

local animTrack
local char
local humanoid
local healThread

local function getHealth()
	local h = LocalPlayer:GetAttribute("Health")
	if type(h) == "number" and h == h and h ~= math.huge and h ~= -math.huge then
		return h
	end
	if humanoid and humanoid.Parent then
		return humanoid.Health
	end
	return 100
end

local function stopHealLoop()
	if healThread then
		pcall(function() task.cancel(healThread) end)
		healThread = nil
	end
end

local function startHealLoop()
	stopHealLoop()
	healThread = task.spawn(function()
		task.wait(2)
		local startHP  = getHealth()
		local targetHP = math.min(startHP + 25, 100)

		local storage      = ReplicatedStorage:FindFirstChild("Storage")
		local eventsFolder = storage and storage:FindFirstChild("Events")
		local damageEvent  = eventsFolder and eventsFolder:FindFirstChild("Damage")
		if not damageEvent then
			healThread = nil
			return
		end

		while healThread do
			local current = getHealth()
			if current >= targetHP then break end

			local step = math.min(1, targetHP - current)
			if step <= 0 then break end

			pcall(function() damageEvent:FireServer(-step) end)
			task.wait(0.1)
		end

		healThread = nil
	end)
end

Event.OnClientEvent:Connect(function(msg)
	if msg == "EatAnim" and animTrack then
		animTrack.Priority = Enum.AnimationPriority.Action4
		animTrack:Play()
		startHealLoop()
	end
end)

script_Parent.Equipped:Connect(function()
	char = LocalPlayer.Character
	humanoid = char and char:FindFirstChildOfClass("Humanoid")
	if humanoid and not VREnabled then
		local Eat = script_Parent:FindFirstChild("Eat")
		if Eat then
			animTrack = humanoid:LoadAnimation(Eat)
		end
	end
end)

script_Parent.Unequipped:Connect(function()
	stopHealLoop()
end)

LocalPlayer.CharacterAdded:Connect(function(newChar)
	char = newChar
	humanoid = newChar:WaitForChild("Humanoid", 5)
	animTrack = nil
	stopHealLoop()
end)]]></ProtectedString>
